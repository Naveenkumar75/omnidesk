# Generate with: openssl rand -hex 32 (shared with the AI service)
JWT_SECRET=change-me-use-at-least-32-characters
HTTP_ADDR=:8080
# LOG_LEVEL=info              # debug | info | warn | error
# SLA_SWEEP_INTERVAL=30s      # how often overdue tickets are checked

